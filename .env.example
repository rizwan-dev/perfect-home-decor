# Public site URL (canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://perfecthomedecor.in

# Google Places API — live rating & review count (server-only; never NEXT_PUBLIC_)
# Enable "Places API" in Google Cloud Console, create a restricted key.
# Place ID for "Perfect Home Decor", Wagholi (verified 2026-07-25;
# CID 15641839200569855066 / ftid 0x3bc2c345208138ed:0xd912f9e0ffbf0c5a):
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJ7TiBIEXDwjsRWgy__-D5Etk

# Contact page map — free ?q=&output=embed only labels the street/building. For “Perfect Home Decor” on the pin, use either:
# A) Google Maps → your business → Share → Embed a map → copy the iframe `src` into:
# NEXT_PUBLIC_GOOGLE_MAPS_IFRAME_SRC=https://www.google.com/maps/embed?pb=...
# B) Maps Embed API: enable “Maps Embed API”, create a browser key restricted by HTTP referrer (site + http://localhost:3000*), then:
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
#    (uses GOOGLE_PLACE_ID above)

# Lead form → email (Nodemailer). Gmail: enable 2-Step Verification → App passwords.
# Use SMTP_USER + SMTP_PASS, or GMAIL_USER + GMAIL_APP_PASSWORD (spaces in app password OK).
# Defaults: smtp.gmail.com:587. LEAD_EMAIL_TO defaults to COMPANY.email if omitted.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=perfecthomedecor.in@gmail.com
SMTP_PASS=your-16-char-app-password
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# LEAD_EMAIL_TO=perfecthomedecor.in@gmail.com

# ─── Leads database + admin page ──────────────────────────────────────────────
# Free Postgres: Vercel dashboard → Storage → Neon (or neon.tech directly).
# Copy the pooled connection string. The `leads` table is created automatically
# on first write, so there is no migration to run.
DATABASE_URL=

# Login for /admin/leads (HTTP Basic). Leaving ADMIN_PASSWORD blank makes the
# page return 503 rather than exposing customer phone numbers.
ADMIN_USER=admin
ADMIN_PASSWORD=
